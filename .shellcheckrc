# Repo-wide shellcheck configuration for the CI shell scripts (ci/*.sh).
# Only false-positive and pure-style codes are disabled here; every substantive
# check (quoting, word-splitting, unused variables, real bugs) stays enabled.
#
# SC2218 ("function only defined later; move the definition up"): false positive
#   for ci/source-build/config.sh and ci/check-wheel-size.sh. Those scripts
#   define every helper / src_<dep>() up front and then invoke them through a
#   dynamic "src_${dep}" dispatch loop; shellcheck's flow analysis cannot follow
#   that indirection and flags an arbitrary subset of identical, correct calls
#   (empirically, reordering the helper only shifts or multiplies the warning).
# SC2012 ("use find instead of ls"): intentional. The CI scripts list known,
#   controlled filenames where ls is correct and more readable than find.
# SC2001 ("use ${var//search/replace} instead of sed"): the sed forms here are
#   deliberate and clearer than the parameter-expansion equivalent.
disable=SC2218,SC2012,SC2001
